@inproceedings{bFaceLivenessDetection2026,
  title = {Face {{Liveness Detection Against Spoofing Attacks}}},
  booktitle = {2026 {{Second International Conference}} on {{Intelligent Systems}} for {{Communication}}, {{IoT}} and {{Security}} ({{ICISCoIS}})},
  author = {B, Vibudesh R and N, Sivadeep and T, Varshine and Gothai, E.},
  date = {2026-01},
  pages = {1--7},
  doi = {10.1109/ICISCoIS62701.2026.11447613},
  url = {https://ieeexplore.ieee.org/document/11447613/},
  urldate = {2026-11-14},
  abstract = {With face recognition based authentication being applied extensively in banks, e-learning and safe access control systems, demonstrating the existence of an actual human has become a critical problem. The attacks by photos and videos and by 3D masks and virtual camera injection invalidate the effectiveness of dominant systems. Most of the existing methods rely solely on passive liveness detection and failed in identifying advanced spoofing attempts, while high sized models are preventing deployment in real-time application. This paper presents a hybrid AI-based face liveness detection system by combining passive, active and environment-based methods to ensure real time, light-weight and safe authentication. The system employs MiniFASNet to passively identify distortions in a texture-based manner and to detect by active microinteraction such as blinking and turning of the head by using MultiFTNet. YOLOv5 is used to apply to face detection and DeepFace to verify identity once liveness is determined. The proposed remedy ensures strong robust- ness to photos and video attacks by spoofing and attacks by conventional 3D masks and virtual cameras while maintaining scalability, light weight character and reasonableness in real world application. By combining both deep learning and hybrid detection techniques this paper is an important movement toward perfecting usability and safety in authen- tication by using biometrics.},
  eventtitle = {2026 {{Second International Conference}} on {{Intelligent Systems}} for {{Communication}}, {{IoT}} and {{Security}} ({{ICISCoIS}})},
  keywords = {Anti-Spoofing,Authentication,Cameras,CNN,DeepFace,delete,Face Liveness Detection,Face recognition,ONNX Runtime,quote,Real-time systems,Runtime,Three-dimensional printing,Turning,Usability,Videos,YOLO,YOLOv5},
  file = {/Users/jonathan/Zotero/storage/FNSXZXVX/B et al. - 2026 - Face Liveness Detection Against Spoofing Attacks.pdf}
}

@online{caldeiraImpactFaceSegmentationBased2026,
  title = {On the {{Impact}} of {{Face Segmentation-Based Background Removal}} on {{Recognition}} and {{Morphing Attack Detection}}},
  author = {Caldeira, Eduarda and Ozgur, Guray and Boutros, Fadi and Damer, Naser},
  date = {2026-04-22},
  eprint = {2604.20585},
  eprinttype = {arXiv},
  eprintclass = {cs.CV},
  doi = {10.48550/arXiv.2604.20585},
  url = {http://arxiv.org/abs/2604.20585},
  urldate = {2026-11-14},
  abstract = {This study investigates the impact of face image background correction through segmentation on face recognition and morphing attack detection performance in realistic, unconstrained image capture scenarios. The motivation is driven by operational biometric systems such as the European Entry/Exit System (EES), which require facial enrolment at airports and other border crossing points where controlled backgrounds usually required for such captures cannot always be guaranteed, as well as by accessibility needs that may necessitate image capture outside traditional office environments. By analyzing how such preprocessing steps influence both recognition accuracy and security mechanisms, this work addresses a critical gap between usability-driven image normalization and the reliability requirements of large-scale biometric identification systems. Our study evaluates a comprehensive range of segmentation techniques, three families of morphing attack detection methods, and four distinct face recognition models, using databases that include both controlled and in-the-wild image captures. The results reveal consistent patterns linking segmentation to both recognition performance and face image quality. Additionally, segmentation is shown to systematically influence morphing attack detection performance. These findings highlight the need for careful consideration when deploying such preprocessing techniques in operational biometric systems.},
  pubstate = {prepublished},
  keywords = {cap1,Computer Science - Computer Vision and Pattern Recognition,quote},
  file = {/Users/jonathan/Zotero/storage/TAEV6YZC/Caldeira et al. - 2026 - On the Impact of Face Segmentation-Based Background Removal on Recognition and Morphing Attack Detec.pdf;/Users/jonathan/Zotero/storage/RKEKJJBM/2604.html}
}

@article{dengArcFaceAdditiveAngular2022,
